{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/legal/:path*",
      "destination": "/legal/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/blog/palm-and-echo",
      "destination": "/blog/introducing-palm-1-0",
      "permanent": true
    },
    {
      "source": "/models/:slug(echo|palm|morph)",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/models",
      "destination": "/#models",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt|robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}